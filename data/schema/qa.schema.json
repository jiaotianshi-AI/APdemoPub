{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa.schema.json",
  "title": "QA samples file",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "question", "answer"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^qa_[a-z0-9_]+$" },
          "question": { "$ref": "#/$defs/localized" },
          "answer": { "$ref": "#/$defs/localized" }
        }
      }
    }
  },
  "$defs": { "localized": { "type": "object", "required": ["zh","en"], "additionalProperties": false, "properties": { "zh": {"type":"string","minLength":1}, "en": {"type":"string","minLength":1} } } }
}
